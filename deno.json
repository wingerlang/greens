{
  "tasks": {
    "dev": "deno run -A --v8-flags=--max-old-space-size=4096 npm:vite@5.4.11",
    "go": "deno run -A --unstable-kv scripts/guardian/runner.ts",
    "server": "DEBUG_MODE=true deno run -A --unstable-kv --watch --env src/api/main.ts",
    "build": "deno run -A npm:vite@5.4.11 build",
    "preview": "deno run -A npm:vite@5.4.11 preview",
    "test": "deno eval \"try { Deno.removeSync('coverage/cov_profile', { recursive: true }); } catch {}\" && deno test -A --unstable-kv --coverage=coverage/cov_profile && deno coverage --exclude=\"src/data|test\" --html coverage/cov_profile && deno run -A scripts/tools/record_coverage.ts",
    "test:cov": "deno eval \"try { Deno.removeSync('coverage/cov_profile', { recursive: true }); } catch {}\" && deno test -A --unstable-kv --coverage=coverage/cov_profile && deno coverage --exclude=\"src/data|test\" coverage/cov_profile",
    "test:lcov": "deno eval \"try { Deno.removeSync('coverage/cov_profile', { recursive: true }); } catch {}\" && deno test -A --unstable-kv --coverage=coverage/cov_profile && deno coverage --exclude=\"src/data|test\" --lcov --output=coverage/lcov.info coverage/cov_profile"
  },
  "test": {
    "exclude": [
      "kv_test.ts",
      "scripts/tools/stress_test.ts"
    ]
  },
  "compilerOptions": {
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable",
      "deno.ns",
      "deno.unstable"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
  "nodeModulesDir": "auto",
  "imports": {
    "react": "npm:react@^19.2.6",
    "react-dom": "npm:react-dom@^19.2.6",
    "react-dom/client": "npm:react-dom@^19.2.6/client",
    "react-router-dom": "npm:react-router-dom@^7.15.1",
    "vite": "npm:vite@5.4.11",
    "@vitejs/plugin-react": "npm:@vitejs/plugin-react@4.3.4",
    "@types/react": "npm:@types/react@^19.2.15",
    "@types/react-dom": "npm:@types/react-dom@^19.2.3",
    "print-js": "npm:print-js@^1.6.0",
    "recharts": "npm:recharts@^2.15.4",
    "lucide-react": "npm:lucide-react@0.469.0",
    "@dnd-kit/core": "npm:@dnd-kit/core@^6.3.1",
    "@dnd-kit/sortable": "npm:@dnd-kit/sortable@^8.0.0",
    "@dnd-kit/utilities": "npm:@dnd-kit/utilities@^3.2.2",
    "zod": "npm:zod@^3.25.76",
    "html2canvas": "npm:html2canvas@^1.4.1",
    "@tanstack/react-query": "npm:@tanstack/react-query@^5.100.11",
    "clsx": "npm:clsx@^2.1.1",
    "date-fns": "npm:date-fns@^4.2.1",
    "tailwind-merge": "npm:tailwind-merge@^2.6.1",
    "framer-motion": "npm:framer-motion@^11.18.2",
    "csv-parse": "npm:csv-parse@^5.6.0",
    "mime-types": "npm:mime-types@^2.1.35",
    "react-markdown": "npm:react-markdown@^9.1.0",
    "remark-gfm": "npm:remark-gfm@^4.0.1",
    "tesseract.js": "npm:tesseract.js@^5.1.1",
    "ws": "npm:ws@^8.20.1",
    "multicast-dns": "npm:multicast-dns@^7.2.5",
